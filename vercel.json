{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "{artifacts/**,burnout_platform/**,burnoutiq/**,frontend/**,templates/**,Datasets/burnoutiq_dataset/data/**}",
      "excludeFiles": "{tests/**,notebooks/**,docs/**,reports/**,data/**,*.ipynb}"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
